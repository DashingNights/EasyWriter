# Dependencies and build output (the release workflow builds from source)
node_modules/
dist/
release/
# The engine's build, which npm run build makes from engine/
/src/engine/wasm/*
!/src/engine/wasm/package.json

# Test runs: throwaway profiles and harnesses (.smoke-data), smoke outputs written to the repo root, smoke scripts, the
# assistant's evaluation (its fixture is the owner's real drafts)
.smoke-data/
smoke-*
test/smoke/
test/assistant-eval/

# Exports for use outside the README (npm run readme-art -- --media)
media/

# The owner's own tools and notes: Claude Code (worktrees, skills, local settings), the editor, the spec and plans
.claude/
.vscode/
SPEC.md
docs/plans/
docs/wiki/

# graphify: the code graph it builds, the scripts that rebuild it and the CLAUDE.md section that points Claude Code at it
graphify-out/
scripts/graph/
CLAUDE.md

# Keys and logs
.env
.env.*
*.log

# Windows
Thumbs.db
desktop.ini
