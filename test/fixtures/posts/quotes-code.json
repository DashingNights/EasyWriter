    },
    {
      "type": "codeBlock",
      "attrs": { "language": "javascript" },
      "content": [
        { "type": "text", "text": "const answer = 42;\nconsole.log(answer);\n" }
      ]
    },
    {
      "type": "codeBlock",
      "attrs": { "language": null },
      "content": [{ "type": "text", "text": "no language named" }]
    },
    { "type": "horizontalRule" },
    {
      "type": "paragraph",
      "content": [{ "type": "text", "text": "After the rule" }]
    }
  ]
