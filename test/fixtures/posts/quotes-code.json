{
  "type": "doc",
  "content": [
    {
      "type": "blockquote",
      "content": [
        { "type": "paragraph", "content": [{ "type": "text", "text": "A quote, said twice: ", "marks": [{ "type": "italic" }] }, { "type": "text", "text": "once here" }] },
        {
          "type": "blockquote",
          "content": [
            { "type": "paragraph", "content": [{ "type": "text", "text": "and once inside it" }] }
