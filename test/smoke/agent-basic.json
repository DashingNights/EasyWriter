[
  { "id": "drafts.create", "args": {}, "expect": { "ok": true } },
  { "id": "doc.insert", "args": { "at": "end", "content": { "markdown": "## Week 3\n\nFirst paragraph about level design.\n\n- one\n- two" } },
    "expect": { "ok": true, "undoSteps": 1, "result": { "paths": [[1], [2], [3]] } } },
  { "id": "doc.find", "args": { "text": "level design" }, "expect": { "ok": true, "result": [{ "path": [2], "from": 22, "to": 34 }] } },
  { "id": "doc.insert", "args": { "at": "start", "content": { "json": { "type": "paragraph", "content": [{ "type": "text", "text": "Intro" }] } } },
    "expect": { "ok": true, "undoSteps": 1, "result": { "paths": [[0]] } } },
  { "id": "doc.replace", "args": { "path": "$steps[2].result.0.path", "content": { "markdown": "Second paragraph, replaced." } }, "ifRev": "$steps[2].rev",
    "expect": { "ok": true, "undoSteps": 1, "result": { "path": [3], "paths": [[3]] } } },
  { "id": "doc.get", "args": { "format": "markdown" }, "expect": { "ok": true } },
  { "id": "doc.delete", "args": { "paths": [[3]] }, "dryRun": true,
    "expect": { "ok": true, "undoSteps": 0, "result": { "deleted": 1 } } },
  { "id": "history.undo", "args": {}, "expect": { "ok": true, "undoSteps": -1, "result": { "undone": 1 } } },
  { "id": "doc.get", "args": { "format": "outline" },
    "expect": { "ok": true, "result": { "content": [{ "text": "Intro" }, { "text": "" }, { "type": "heading", "text": "Week 3" }, { "text": "First paragraph about level design." }] } } },
  { "id": "drafts.setTag", "args": { "draftId": "$steps[0].result.draftId", "tagId": "done" },
    "expect": { "ok": true, "result": { "tagId": "done", "previous": null } } },
  { "id": "drafts.unpush", "args": { "draftId": "$steps[0].result.draftId" },
    "expect": { "ok": false, "code": "precondition_failed", "error": { "data": { "failed": [{ "gate": "draft.pushed" }] } } } },
  { "id": "tags.add", "args": { "name": "Smoke tag", "color": "#123456" }, "expect": { "ok": true } },
  { "id": "drafts.setTag", "args": { "draftId": "$steps[0].result.draftId", "tagId": "$prev.result.tagId" },
    "expect": { "ok": true, "result": { "previous": "done" } } },
  { "id": "tags.remove", "args": { "tagId": "$steps[11].result.tagId" },
    "expect": { "ok": true, "result": { "tag": { "name": "Smoke tag", "color": "#123456" }, "draftIds": [] } } },
  { "id": "settings.patch", "args": { "patch": { "forumWidth": 1200 } }, "expect": { "ok": true, "result": { "keys": ["forumWidth"] } } },
  { "id": "threads.add", "args": { "url": "https://daf.staffs.ac.uk/topic/99999-smoke-thread/?tab=comments" },
    "expect": { "ok": true, "result": { "url": "https://daf.staffs.ac.uk/topic/99999-smoke-thread/" } } },
  { "id": "threads.add", "args": { "url": "https://daf.staffs.ac.uk/topic/99999-smoke-thread/" }, "expect": { "ok": false, "code": "already_exists" } },
  { "id": "threads.remove", "args": { "url": "https://daf.staffs.ac.uk/topic/99999-smoke-thread/" }, "expect": { "ok": true } },
  { "id": "doc.format", "args": { "path": [3], "from": 0, "to": 5, "marks": { "bold": true } },
    "expect": { "ok": true, "undoSteps": 1, "result": { "path": [3], "from": 0, "to": 5 } } },
  { "id": "doc.get", "args": { "format": "markdown", "path": [3] }, "expect": { "ok": true, "result": { "content": "**First** paragraph about level design." } } },
  { "id": "doc.command", "args": { "name": "setHeading", "args": [{ "level": 2 }] }, "expect": { "ok": true, "undoSteps": 1 } },
  { "id": "doc.command", "args": { "name": "deleteSelection" }, "expect": { "ok": false, "code": "denied", "error": { "data": { "reason": "policy" } } } },
  { "id": "tool.list", "args": {}, "expect": { "ok": true, "result": [{}, {}, {}, {}, {}, {}, {}, {}, {}, { "id": "bold", "group": "Text" }] } },
  { "id": "board.insert", "args": { "kind": "whiteboard", "at": "end" }, "expect": { "ok": true, "undoSteps": 1 } },
  { "id": "board.items.add", "args": { "path": "$prev.result.path", "items": [
      { "type": "text", "html": "Smoke board text", "x": 20, "y": 20, "w": 300 },
      { "type": "shape", "shape": "rect", "x": 40, "y": 120, "w": 160, "h": 100, "fill": "solid", "fillColor": "#e09952" }] },
    "expect": { "ok": true, "undoSteps": 1, "result": { "ids": { "$length": 2 } } } },
  { "id": "board.items.update", "args": { "path": "$steps[23].result.path", "id": "$prev.result.ids.1", "patch": { "x": 400, "y": 140 } },
    "expect": { "ok": true, "undoSteps": 1, "result": { "item": { "type": "shape", "x": 400, "y": 140 } } } },
  { "id": "board.render", "args": { "path": "$steps[23].result.path" },
    "expect": { "ok": true, "result": { "width": 2400, "height": 800, "bytes": { "$gt": 1000 } } } },
  { "id": "board.items.remove", "args": { "path": "$steps[23].result.path", "ids": ["$steps[24].result.ids.1"] },
    "expect": { "ok": true, "undoSteps": 1, "result": { "removed": { "$length": 1 } } } },
  { "id": "export.preview", "args": {}, "expect": { "ok": true, "result": { "html": { "$contains": "Intro" }, "images": { "$length": 1 } } } },
  { "id": "push.prepare", "args": { "draftId": "$steps[0].result.draftId" },
    "expect": { "ok": false, "code": "precondition_failed", "error": { "data": { "failed": [{ "gate": "draft.hasThread" }] } } } },
  { "id": "commands.index", "args": {}, "expect": { "ok": true, "result": { "categories": [{ "category": "app" }] } } },
  { "id": "commands.index", "args": { "category": "board" },
    "expect": { "ok": true, "result": { "tools": [{ "name": "board_list" }, {}, {}, { "name": "board_items_add", "risk": "write" }] } } },
  { "id": "commands.describe", "args": { "names": ["board_set", "nope"] },
    "expect": { "ok": true, "result": { "tools": { "$length": 1 }, "risk": { "board_set": "write" }, "unknown": ["nope"] } } },
  { "id": "batch", "args": { "steps": [
      { "id": "doc_insert", "args": { "at": "end", "content": { "markdown": "Batch line one" } } },
      { "id": "doc.insert", "args": { "at": "end", "content": { "markdown": "Batch line two" } } }] },
    "expect": { "ok": true, "undoSteps": 1, "result": { "results": { "$length": 2 } } } },
  { "id": "drafts.delete", "args": { "draftId": "$steps[0].result.draftId" }, "expect": { "ok": true, "result": { "trashed": true } } }
]
