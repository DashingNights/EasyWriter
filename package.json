{
  "name": "easywriter",
  "productName": "EasyWriter",
  "version": "1.3.0",
  "private": true,
  "description": "Desktop editor for drafts in projects, with canvases, flowcharts and plans, and an optional forum integration",
  "author": "DashingNights",
  "repository": "github:DashingNights/EasyWriter",
  "main": "main.js",
  "bin": {
    "easywriter-agent": "bin/easywriter-agent.js"
  },
  "scripts": {
    "agent": "node bin/easywriter-agent.js",
    "build": "esbuild src/main.jsx --bundle --outfile=dist/renderer.js --format=iife --jsx=automatic --minify --sourcemap --define:process.env.NODE_ENV=\\\"production\\\" && tailwindcss -i src/app.css -o dist/app.css --minify",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "smoke:agent": "npm run build && electron . --smoke --data-dir=.smoke-data --script=test/smoke/agent-basic.json",
    "smoke:forum": "npm run build && node -e \"const fs=require('fs'),d='.smoke-data/forum';fs.rmSync(d,{recursive:true,force:true});fs.mkdirSync(d,{recursive:true});fs.writeFileSync(d+'/settings.json',JSON.stringify({onboarded:true,demoSeeded:true,integrations:{forum:{enabled:true}},forumUrl:'https://forum.test'}))\" && electron . --smoke --data-dir=.smoke-data/forum --script=test/smoke/agent-forum.json",
    "smoke:document": "npm run build && node -e \"const fs=require('fs'),d='.smoke-data/document';fs.rmSync(d,{recursive:true,force:true});fs.mkdirSync(d,{recursive:true});fs.writeFileSync(d+'/settings.json',JSON.stringify({onboarded:true,demoSeeded:true}))\" && electron . --smoke --data-dir=.smoke-data/document --script=test/smoke/agent-document.json",
    "assistant:eval": "npm run build && electron test/assistant-eval/run.js",
    "assistant:matrix": "node test/assistant-eval/matrix.js",
    "test": "node --test \"test/*.test.*\"",
    "icon": "electron scripts/make-icon.js build/icon.svg build",
    "readme-art": "npm run build && electron scripts/readme-art.js",
    "shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File shortcuts.ps1",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.dashingnights.easywriter",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "build/icon.ico",
      "build/icon.svg",
      "dist/**",
      "!dist/*.map",
      "src/**",
      "!src/**/*.jsx",
      "!src/**/*.css",
      "bin/**"
    ],
    "asarUnpack": [
      "bin/**"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup.${ext}",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DashingNights",
        "repo": "EasyWriter",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
